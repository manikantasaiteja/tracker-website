# MongoDB Configuration (if using MongoDB for additional data)
MONGODB_URI=mongodb://localhost:27017/trackr

# NextAuth Configuration (if using NextAuth)
NEXTAUTH_SECRET=your-secret-key-change-this-in-production
NEXTAUTH_URL=http://localhost:3000

# Supabase Configuration (Required)
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (Optional - only for server-side admin operations)
# WARNING: Never expose this key in client-side code!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin Configuration
# Set this to enable/disable admin approval requirement
NEXT_PUBLIC_REQUIRE_ADMIN_APPROVAL=true

# Google OAuth / Gmail Sync
# Get these from: https://console.cloud.google.com/apis/credentials
# 1. Create a new project (or use existing)
# 2. Enable the Gmail API
# 3. Create OAuth 2.0 credentials (Web application)
# 4. Add http://localhost:3000/api/gmail/callback to Authorized redirect URIs
# 5. For production, also add https://your-domain.com/api/gmail/callback
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Supabase Service Role Key (required for server-side Gmail token storage)
# WARNING: Never expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Gemini AI (for Tools: ATS Checker, Resume Optimizer, Cover Letter)
# Get a free API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
